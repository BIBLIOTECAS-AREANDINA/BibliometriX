    given-names: "Alejandro"
    alias: "REKOL08"
version: 2.0.0
date-released: 2026-07-22
url: "https://rekol08.github.io/BibliometriX/"
repository-code: "https://github.com/REKOL08/BibliometriX"
license: MIT
keywords:
  - bibliometría
  - bibliometrics
  - scopus
  - web-of-science
  - análisis-de-citas
  - scientometrics
